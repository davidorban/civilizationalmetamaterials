cff-version: 1.2.0
title: "Civilizational Metamaterials: Engineering Coordination Under Capability Gradients and Structural Turbulence"
message: "If you use this work, please cite it using these metadata."
type: software
authors:
  - family-names: Orban
    given-names: David
    orcid: "https://orcid.org/0009-0004-4954-1147"
